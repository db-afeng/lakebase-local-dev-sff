# 1. add project name e.g. datacart-alex-feng (the stuff behind projects/...)
LAKEBASE_PROJECT_NAME="${LAKEBASE_PROJECT_NAME:-}"

# 2. add databricks cli profile name
LAKEBASE_PROFILE="${LAKEBASE_PROFILE:-}"

# 3. add your email as the postgres role e.g. alex.feng@databricks.com (same email identity to login to databricks)
LAKEBASE_PG_ROLE="${LAKEBASE_PG_ROLE:-}"

# The defaults below normally need no changes.
LAKEBASE_PARENT_BRANCH="${LAKEBASE_PARENT_BRANCH:-production}"
LAKEBASE_DATABASE="${LAKEBASE_DATABASE:-databricks_postgres}"
LAKEBASE_BRANCH_TTL="${LAKEBASE_BRANCH_TTL:-21600s}"
# Used only if provisioning needs to create a read-write endpoint; existing ones are discovered.
LAKEBASE_ENDPOINT_ID="${LAKEBASE_ENDPOINT_ID:-dev}"
LAKEBASE_PG_OPTIONS="${LAKEBASE_PG_OPTIONS:--c role=datacart_storefront_owner}"
